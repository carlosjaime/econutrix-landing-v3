---
// LandingPage EcoNutrix
// Author: Carlos Jaime Lopez Martinez
// Fecha: 20-Abril-2026

import { Image } from 'astro:assets';
import logoEcoNutrix from '../../assets/images/logo_econutrix.png';
---

<footer data-motion-section class="relative overflow-hidden bg-[#05051a] pb-7 pt-10 sm:pt-12 lg:pb-8 lg:pt-14">
  <div class="relative mx-auto max-w-[1320px] px-6 lg:px-10">
    <div>
      <a data-motion="media" href="/" class="inline-flex items-center">
        <Image src={logoEcoNutrix} alt="EcoNutrix" class="h-14 w-auto sm:h-16" />
      </a>
      <p data-motion="text" style="--motion-delay: 70ms;" class="mt-3 text-[0.88rem] text-white/58 sm:text-[0.94rem]">Menos decisiones, más tiempo</p>
    </div>

    <div class="mt-2 border-t border-white/10"></div>

    <div data-motion-stagger class="grid grid-cols-2 gap-x-6 gap-y-8 pb-0 pt-7 sm:gap-10 sm:pt-8 md:grid-cols-[1fr_1fr_1fr] lg:gap-20">
      <div>
        <p class="text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-white/34 sm:text-[0.82rem]">Producto</p>
        <ul class="mt-4 space-y-2.5 text-[0.88rem] text-white/56 sm:space-y-3 sm:text-[0.96rem]">
          <li><a href="#como-funciona" class="transition-colors hover:text-white">Cómo funciona</a></li>
          <li><a href="#beneficios" class="transition-colors hover:text-white">Beneficios</a></li>
          <li><a href="#acceso" class="transition-colors hover:text-white">Acceso anticipado</a></li>
        </ul>
      </div>

      <div>
        <p class="text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-white/34 sm:text-[0.82rem]">Legal</p>
        <ul class="mt-4 space-y-2.5 text-[0.88rem] text-white/56 sm:space-y-3 sm:text-[0.96rem]">
          <li><a href="#" data-open-legal="terms" class="transition-colors hover:text-white">Términos de uso</a></li>
          <li><a href="#" data-open-legal="privacy" class="transition-colors hover:text-white">Privacidad</a></li>
          <li><a href="#" id="footer-cookies-open" class="transition-colors hover:text-white">Cookies</a></li>
        </ul>
      </div>

      <div class="col-span-2 md:col-span-1">
        <p class="text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-white/34 sm:text-[0.82rem]">Contacto</p>
        <a href="mailto:contacto@econutrix.com" class="mt-4 inline-block text-[0.88rem] text-white/56 transition-colors hover:text-white sm:text-[0.96rem]">
          contacto@econutrix.com
        </a>
      </div>
    </div>

    <div class="mt-1 border-t border-white/10"></div>
    <div data-motion="text" style="--motion-delay: 120ms;" class="flex flex-col items-start justify-between gap-2 pt-5 sm:flex-row sm:items-center sm:gap-4">
      <p class="text-[0.8rem] text-white/42 sm:text-[0.88rem]">© 2026 EcoNutrix. Todos los derechos reservados.</p>
      <p class="text-[0.8rem] tracking-[0.03em] text-white/38 sm:text-[0.88rem]">LATAM</p>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('footer-cookies-open')?.addEventListener('click', function(e) {
    e.preventDefault();
    const modal = document.getElementById('cookie-modal');
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  });
</script>
