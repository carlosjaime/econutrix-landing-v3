---
// LandingPage EcoNutrix
// Author: Carlos Jaime Lopez Martinez
// Fecha: 20-Abril-2026

import { contextTags } from '../../data/landing';
import { Image } from 'astro:assets';
import tagWeatherIcon from '../../assets/images/Iconify-icon (5).svg';
import tagTasteIcon from '../../assets/images/Icon (4).svg';
import tagGoalsIcon from '../../assets/images/Icon (5).svg';
import tagIngredientsIcon from '../../assets/images/Iconify-icon (6).svg';
import tagAllergyIcon from '../../assets/images/Iconify-icon (7).svg';
import tagCultureIcon from '../../assets/images/Iconify-icon (8).svg';

const contextTagIcons = [
  tagWeatherIcon,
  tagTasteIcon,
  tagGoalsIcon,
  tagIngredientsIcon,
  tagAllergyIcon,
  tagCultureIcon,
] as const;
---

<section data-motion-section class="relative overflow-hidden bg-[#0D0A1A] py-20 lg:py-28">
  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:gap-16">
      <div class="shrink-0 lg:max-w-[380px]">
        <h2 data-motion="heading" class="text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">No solo decidir qué cocinar.</h2>
        <p data-motion="text" style="--motion-delay: 90ms;" class="mt-5 text-base leading-relaxed text-white/55">
          EcoNutrix aprovecha lo que tienes y deja de perder tiempo pensando qué hay en casa.
          Lo que no usas, lo pierdes. EcoNutrix lo evita por ti.
        </p>
        <a data-motion="button" style="--motion-delay: 150ms;" href="#probarlo" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-[#A34DA3] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#8B3C8B]">
          Reservar acceso
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
        </a>
      </div>
      <div class="min-w-0 flex-1">
        <!-- Mobile: grid 2 columnas -->
        <div data-motion-stagger class="grid grid-cols-2 gap-3 lg:hidden">
          {contextTags.map((tag, index) => (
            <span data-motion="card" class="inline-flex cursor-default items-center gap-2 rounded-[20px] border border-[#c8c8cf] bg-white px-4 py-3 text-sm font-semibold text-[#474747] shadow-[0_2px_0_rgba(8,8,28,0.10)]">
              <Image src={contextTagIcons[index]} alt="" aria-hidden="true" class="h-4 w-4 shrink-0" />
              {tag}
            </span>
          ))}
        </div>
        <!-- Desktop: pirámide 3-2-1 -->
        <div data-motion-stagger class="hidden flex-col items-center gap-4 lg:flex">
          <div class="flex gap-4">
            {contextTags.slice(0, 3).map((tag, index) => (
              <span data-motion="card" class="inline-flex cursor-default items-center gap-3 rounded-[20px] border border-[#c8c8cf] bg-white px-5 py-3 text-[1.05rem] font-semibold text-[#474747] shadow-[0_2px_0_rgba(8,8,28,0.10)]">
                <Image src={contextTagIcons[index]} alt="" aria-hidden="true" class="h-[1.05rem] w-[1.05rem] shrink-0" />
                {tag}
              </span>
            ))}
          </div>
          <div class="flex gap-4">
            {contextTags.slice(3, 5).map((tag, index) => (
              <span data-motion="card" class="inline-flex cursor-default items-center gap-3 rounded-[20px] border border-[#c8c8cf] bg-white px-5 py-3 text-[1.05rem] font-semibold text-[#474747] shadow-[0_2px_0_rgba(8,8,28,0.10)]">
                <Image src={contextTagIcons[index + 3]} alt="" aria-hidden="true" class="h-[1.05rem] w-[1.05rem] shrink-0" />
                {tag}
              </span>
            ))}
          </div>
          <div class="flex">
            <span data-motion="card" class="inline-flex cursor-default items-center gap-3 rounded-[20px] border border-[#c8c8cf] bg-white px-5 py-3 text-[1.05rem] font-semibold text-[#474747] shadow-[0_2px_0_rgba(8,8,28,0.10)]">
              <Image src={contextTagIcons[5]} alt="" aria-hidden="true" class="h-[1.05rem] w-[1.05rem] shrink-0" />
              {contextTags[5]}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
