---
// Cookie consent banner + preferences modal
---

<!-- Banner — estilos críticos inline para que funcione antes de que cargue Tailwind -->
<div
  id="cookie-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
  style="display:none; position:fixed; left:0; right:0; bottom:0; z-index:9998; padding:0 12px 12px;"
>
  <div style="
    position:relative;
    max-width:1480px;
    margin:0 auto;
    background:#0d0e28;
    color:#fff;
    border-top:2px solid #694BD6;
    box-shadow:0 -4px 40px rgba(0,0,0,0.6);
    padding:18px 20px;
  ">

    <!-- Layout: texto izquierda | botones + X derecha -->
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">

      <!-- Texto -->
      <div style="flex:1;min-width:200px;font-size:0.875rem;line-height:1.6;color:rgba(255,255,255,0.9);">
        <p style="margin:0;">Utilizamos cookies para mejorar tu experiencia, analizar el uso de la plataforma y ofrecer contenido personalizado.</p>
        <button
          type="button"
          id="cookie-policy-open"
          style="display:inline-block;margin-top:4px;color:#694BD6;text-decoration:underline;text-underline-offset:3px;text-decoration-color:rgba(105,75,214,0.7);font-size:0.875rem;background:transparent;border:0;cursor:pointer;padding:0;"
        >
          "Más información en nuestra Política de Cookies"
        </button>
      </div>

      <!-- Botones + X alineados al centro derecha -->
      <div id="cookie-btns" style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
        <button
          type="button"
          id="cookie-configure"
          style="white-space:nowrap;padding:11px 32px;font-size:0.9rem;font-weight:500;color:#fff;background:transparent;border:1.5px solid #694BD6;border-radius:10px;cursor:pointer;text-decoration:underline;text-underline-offset:4px;"
          onmouseover="this.style.background='rgba(105,75,214,0.12)'"
          onmouseout="this.style.background='transparent'"
        >
          Configurar cookies
        </button>
        <button
          type="button"
          id="cookie-accept"
          style="white-space:nowrap;padding:11px 28px;font-size:0.9rem;font-weight:600;color:#fff;background:#694BD6;border:0;border-radius:10px;cursor:pointer;"
          onmouseover="this.style.background='#7a5ee0'"
          onmouseout="this.style.background='#694BD6'"
        >
          <strong>Aceptar todo</strong>
        </button>
        <!-- X cerrar — centrada verticalmente -->
        <button
          type="button"
          id="cookie-close"
          aria-label="Cerrar aviso de cookies"
          style="width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;cursor:pointer;color:rgba(255,255,255,0.75);border-radius:6px;flex-shrink:0;"
          onmouseover="this.style.background='rgba(255,255,255,0.1)';this.style.color='#fff'"
          onmouseout="this.style.background='transparent';this.style.color='rgba(255,255,255,0.75)'"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</div>

<!-- Modal de preferencias -->
<div
  id="cookie-modal"
  style="display:none; position:fixed; inset:0; z-index:10000; align-items:center; justify-content:center; padding:16px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-modal-title"
>
  <div id="cookie-modal-backdrop" style="position:absolute;inset:0;background:rgba(0,0,0,0.72);backdrop-filter:blur(6px);"></div>

  <div style="position:relative;width:100%;max-width:680px;background:#1a0b2e;color:#fff;border-radius:20px;box-shadow:0 24px 64px rgba(0,0,0,0.6);overflow:hidden;">

    <!-- Header -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;border-bottom:1px solid rgba(255,255,255,0.1);padding:24px 28px 20px;">
      <div>
        <h2 id="cookie-modal-title" style="margin:0;font-size:1.25rem;font-weight:700;color:#fff;">Preferencias de cookies</h2>
        <p style="margin:8px 0 0;font-size:0.9rem;line-height:1.5;color:rgba(255,255,255,0.7);">
          Elige qué categorías quieres permitir. Puedes cambiar esta configuración en cualquier momento.
        </p>
      </div>
      <button
        type="button"
        id="cookie-modal-close"
        aria-label="Cerrar"
        style="flex-shrink:0;width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;cursor:pointer;color:rgba(255,255,255,0.7);border-radius:8px;margin-top:-4px;"
        onmouseover="this.style.background='rgba(255,255,255,0.1)';this.style.color='#fff'"
        onmouseout="this.style.background='transparent';this.style.color='rgba(255,255,255,0.7)'"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Categorías -->
    <div style="padding:20px 28px;display:flex;flex-direction:column;gap:12px;max-height:60vh;overflow-y:auto;">

      <!-- Necesarias -->
      <label style="display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);border-radius:12px;padding:18px 20px;">
        <span>
          <span style="display:block;font-size:1rem;font-weight:700;color:#fff;">Necesarias</span>
          <span style="display:block;margin-top:4px;font-size:0.875rem;color:rgba(255,255,255,0.65);">Imprescindibles para el funcionamiento del sitio. No se pueden desactivar.</span>
        </span>
        <input type="checkbox" checked disabled style="width:20px;height:20px;flex-shrink:0;cursor:not-allowed;accent-color:#694BD6;" />
      </label>

      <!-- Analíticas -->
      <label style="display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);border-radius:12px;padding:18px 20px;cursor:pointer;">
        <span>
          <span style="display:block;font-size:1rem;font-weight:700;color:#fff;">Analíticas</span>
          <span style="display:block;margin-top:4px;font-size:0.875rem;color:rgba(255,255,255,0.65);">Nos ayudan a entender cómo se usa la plataforma para mejorarla.</span>
        </span>
        <input type="checkbox" data-cookie-category="analytics" style="width:20px;height:20px;flex-shrink:0;cursor:pointer;accent-color:#694BD6;" />
      </label>

      <!-- Marketing -->
      <label style="display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);border-radius:12px;padding:18px 20px;cursor:pointer;">
        <span>
          <span style="display:block;font-size:1rem;font-weight:700;color:#fff;">Marketing</span>
          <span style="display:block;margin-top:4px;font-size:0.875rem;color:rgba(255,255,255,0.65);">Se utilizan para mostrarte contenido y anuncios personalizados.</span>
        </span>
        <input type="checkbox" data-cookie-category="marketing" style="width:20px;height:20px;flex-shrink:0;cursor:pointer;accent-color:#694BD6;" />
      </label>

      <!-- Personalización -->
      <label style="display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.05);border-radius:12px;padding:18px 20px;cursor:pointer;">
        <span>
          <span style="display:block;font-size:1rem;font-weight:700;color:#fff;">Personalización</span>
          <span style="display:block;margin-top:4px;font-size:0.875rem;color:rgba(255,255,255,0.65);">Recuerdan tus preferencias para ofrecerte una experiencia adaptada.</span>
        </span>
        <input type="checkbox" data-cookie-category="personalization" style="width:20px;height:20px;flex-shrink:0;cursor:pointer;accent-color:#694BD6;" />
      </label>
    </div>

    <!-- Footer modal -->
    <div style="display:flex;flex-direction:row;gap:12px;border-top:1px solid rgba(255,255,255,0.1);padding:20px 28px;">
      <button
        type="button"
        id="cookie-reject-all"
        style="flex:1;padding:13px 20px;font-size:0.9rem;font-weight:500;color:#fff;background:transparent;border:1.5px solid rgba(255,255,255,0.25);border-radius:10px;cursor:pointer;"
        onmouseover="this.style.background='rgba(255,255,255,0.08)'"
        onmouseout="this.style.background='transparent'"
      >
        Rechazar opcionales
      </button>
      <button
        type="button"
        id="cookie-save"
        style="flex:1;padding:13px 20px;font-size:0.9rem;font-weight:700;color:#fff;background:#694BD6;border:0;border-radius:10px;cursor:pointer;"
        onmouseover="this.style.background='#7a5ee0'"
        onmouseout="this.style.background='#694BD6'"
      >
        Guardar preferencias
      </button>
    </div>
  </div>
</div>

<!-- Modal Política de Cookies -->
<div
  id="cookie-policy-modal"
  style="display:none; position:fixed; inset:0; z-index:10001; align-items:center; justify-content:center; padding:16px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-policy-title"
>
  <div style="position:absolute;inset:0;background:rgba(0,0,0,0.70);" id="cookie-policy-backdrop"></div>
  <div style="position:relative;width:100%;max-width:760px;max-height:88vh;background:#fff;border-radius:8px;box-shadow:0 24px 64px rgba(0,0,0,0.5);overflow:hidden;display:flex;flex-direction:column;">

    <!-- Header -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 28px;border-bottom:2px solid #694BD6;">
      <h2 id="cookie-policy-title" style="margin:0;font-size:1.15rem;font-weight:700;color:#1a1a2e;">Política de Cookies</h2>
      <button
        type="button"
        id="cookie-policy-close"
        aria-label="Cerrar"
        style="width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;background:#694BD6;border:0;border-radius:50%;cursor:pointer;color:#fff;flex-shrink:0;"
        onmouseover="this.style.background='#7a5ee0'"
        onmouseout="this.style.background='#694BD6'"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Contenido -->
    <div style="overflow-y:auto;padding:24px 28px;font-size:0.9rem;line-height:1.7;color:#374151;">

      <h3 style="font-size:0.95rem;font-weight:700;color:#1a1a2e;margin:0 0 8px;">1. ¿Qué son las cookies?</h3>
      <p style="margin:0 0 6px;">Las cookies son pequeños archivos de texto que se guardan en tu dispositivo (ordenador, tablet o smartphone) cuando visitas un sitio web.</p>
      <p style="margin:0 0 6px;">Sirven para recordar tus preferencias, mejorar el rendimiento del sitio y, en algunos casos, recopilar información estadística o de personalización.</p>
      <p style="margin:0 0 20px;">Las cookies <strong>no almacenan información personal sensible</strong> como nombres, contraseñas o datos financieros.</p>

      <h3 style="font-size:0.95rem;font-weight:700;color:#1a1a2e;margin:0 0 8px;">2. ¿Qué tipos de cookies usamos?</h3>
      <p style="margin:0 0 6px;"><strong>Cookies necesarias:</strong> Imprescindibles para el funcionamiento del sitio. No requieren consentimiento.</p>
      <p style="margin:0 0 6px;"><strong>Cookies analíticas:</strong> Nos permiten entender cómo los usuarios interactúan con la plataforma para mejorarla (p. ej. páginas visitadas, tiempo de sesión).</p>
      <p style="margin:0 0 6px;"><strong>Cookies de marketing:</strong> Utilizadas para mostrar contenido y anuncios personalizados según tus intereses.</p>
      <p style="margin:0 0 20px;"><strong>Cookies de personalización:</strong> Recuerdan tus preferencias de idioma, región y configuración para ofrecerte una experiencia adaptada.</p>

      <h3 style="font-size:0.95rem;font-weight:700;color:#1a1a2e;margin:0 0 8px;">3. ¿Cómo puedes gestionar las cookies?</h3>
      <p style="margin:0 0 6px;">Puedes configurar tus preferencias de cookies en cualquier momento a través del panel de configuración disponible en el banner de cookies de esta página.</p>
      <p style="margin:0 0 6px;">También puedes gestionar o eliminar las cookies desde la configuración de tu navegador:</p>
      <ul style="margin:6px 0 20px;padding-left:20px;">
        <li>Chrome: Configuración → Privacidad y seguridad → Cookies</li>
        <li>Firefox: Opciones → Privacidad y seguridad</li>
        <li>Safari: Preferencias → Privacidad</li>
        <li>Edge: Configuración → Privacidad, búsqueda y servicios</li>
      </ul>

      <h3 style="font-size:0.95rem;font-weight:700;color:#1a1a2e;margin:0 0 8px;">4. Cookies de terceros</h3>
      <p style="margin:0 0 20px;">Algunos servicios integrados en nuestra plataforma pueden establecer sus propias cookies (p. ej. herramientas de análisis o redes de publicidad). Estos terceros tienen sus propias políticas de privacidad.</p>

      <h3 style="font-size:0.95rem;font-weight:700;color:#1a1a2e;margin:0 0 8px;">5. Actualizaciones de esta política</h3>
      <p style="margin:0 0 6px;">EcoNutrix puede actualizar esta Política de Cookies en cualquier momento. La versión vigente siempre estará disponible en esta página con la fecha de última modificación.</p>
      <p style="margin:0;">Para cualquier consulta, escríbenos a <a href="mailto:privacidad@econutrix.com" style="color:#694BD6;text-decoration:underline;">privacidad@econutrix.com</a>.</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'econutrix:cookie-consent';
    const banner = document.getElementById('cookie-banner');
    const modal  = document.getElementById('cookie-modal');
    if (!banner || !modal) return;

    const checkboxes = modal.querySelectorAll('input[data-cookie-category]');

    /* ── helpers ── */
    function readStored() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); }
      catch (_) { return null; }
    }

    function hideBanner() {
      banner.style.display = 'none';
    }

    function showBanner() {
      banner.style.display = '';
    }

    function save(consent) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...consent, ts: Date.now() })); }
      catch (_) {}
      hideBanner();
      closeModal();
    }

    function openModal() {
      const stored = readStored();
      checkboxes.forEach((cb) => {
        const key = cb.getAttribute('data-cookie-category');
        cb.checked = stored && stored.categories ? !!stored.categories[key] : false;
      });
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    function collectCategories() {
      const cats = { necessary: true };
      checkboxes.forEach((cb) => {
        const key = cb.getAttribute('data-cookie-category');
        if (key) cats[key] = cb.checked;
      });
      return cats;
    }

    /* ── mostrar siempre (sin verificar localStorage) ── */
    showBanner();

    /* ── eventos ── */
    document.getElementById('cookie-accept')?.addEventListener('click', () =>
      save({ value:'accepted-all', categories:{ necessary:true, analytics:true, marketing:true, personalization:true } })
    );
    document.getElementById('cookie-close')?.addEventListener('click', () =>
      save({ value:'dismissed', categories:{ necessary:true } })
    );
    document.getElementById('cookie-configure')?.addEventListener('click', openModal);
    document.getElementById('cookie-modal-close')?.addEventListener('click', closeModal);
    document.getElementById('cookie-modal-backdrop')?.addEventListener('click', closeModal);
    document.getElementById('cookie-reject-all')?.addEventListener('click', () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      save({ value:'rejected-optional', categories:collectCategories() });
    });
    document.getElementById('cookie-save')?.addEventListener('click', () =>
      save({ value:'custom', categories:collectCategories() })
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.style.display !== 'none') closeModal();
    });

    /* ── Modal política de cookies ── */
    const policyModal = document.getElementById('cookie-policy-modal');
    const openPolicy = () => { if (policyModal) { policyModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; } };
    const closePolicy = () => { if (policyModal) { policyModal.style.display = 'none'; document.body.style.overflow = ''; } };
    document.getElementById('cookie-policy-open')?.addEventListener('click', openPolicy);
    document.getElementById('cookie-policy-close')?.addEventListener('click', closePolicy);
    document.getElementById('cookie-policy-backdrop')?.addEventListener('click', closePolicy);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && policyModal?.style.display !== 'none') closePolicy();
    });
  })();
</script>
