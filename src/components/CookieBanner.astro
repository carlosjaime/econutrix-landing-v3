---
// Cookie consent banner + preferences modal
---

<!-- Banner — estilos críticos inline para que funcione antes de que cargue Tailwind -->
<div
  id="cookie-banner"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
  style="display:none; position:fixed; left:0; right:0; bottom:0; z-index:9998; padding:0 12px 12px;"
>
  <div style="
    position:relative;
    max-width:1480px;
    margin:0 auto;
    background:#0d0e28;
    color:#fff;
    border-top:2px solid #694BD6;
    box-shadow:0 -4px 40px rgba(0,0,0,0.6);
    padding:14px 52px 14px 20px;
  ">

    <!-- X cerrar — siempre visible en esquina superior derecha -->
    <button
      type="button"
      id="cookie-close"
      aria-label="Cerrar aviso de cookies"
      style="position:absolute;top:10px;right:10px;width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;cursor:pointer;color:rgba(255,255,255,0.75);border-radius:6px;"
      onmouseover="this.style.background='rgba(255,255,255,0.1)';this.style.color='#fff'"
      onmouseout="this.style.background='transparent';this.style.color='rgba(255,255,255,0.75)'"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    <!-- Layout: texto + botones -->
    <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">

      <!-- Texto -->
      <div style="flex:1;min-width:200px;font-size:0.875rem;line-height:1.6;color:rgba(255,255,255,0.9);">
        <p style="margin:0;">Utilizamos cookies para mejorar tu experiencia, analizar el uso de la plataforma y ofrecer contenido personalizado.</p>
        <button
          type="button"
          id="cookie-policy-open"
          style="display:inline-block;margin-top:4px;color:#694BD6;text-decoration:underline;text-underline-offset:3px;text-decoration-color:rgba(105,75,214,0.7);font-size:0.875rem;background:transparent;border:0;cursor:pointer;padding:0;"
        >
          "Más información en nuestra Política de Cookies"
        </button>
      </div>

      <!-- Botones acción -->
      <div id="cookie-btns" style="display:flex;align-items:center;gap:10px;flex-shrink:0;">
        <button
          type="button"
          id="cookie-configure"
          style="white-space:nowrap;padding:11px 32px;font-size:0.9rem;font-weight:500;color:#fff;background:transparent;border:1.5px solid #694BD6;border-radius:10px;cursor:pointer;text-decoration:underline;text-underline-offset:4px;"
          onmouseover="this.style.background='rgba(105,75,214,0.12)'"
          onmouseout="this.style.background='transparent'"
        >
          Configurar cookies
        </button>
        <button
          type="button"
          id="cookie-accept"
          style="white-space:nowrap;padding:11px 28px;font-size:0.9rem;font-weight:600;color:#fff;background:#694BD6;border:0;border-radius:10px;cursor:pointer;"
          onmouseover="this.style.background='#7a5ee0'"
          onmouseout="this.style.background='#694BD6'"
        >
          <strong>Aceptar todo</strong>
        </button>
      </div>

    </div>
  </div>
</div>

<!-- Modal de preferencias (incluye política de cookies integrada) -->
<div
  id="cookie-modal"
  style="display:none; position:fixed; inset:0; z-index:10000; align-items:center; justify-content:center; padding:16px;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-modal-title"
>
  <div id="cookie-modal-backdrop" style="position:absolute;inset:0;background:rgba(0,0,0,0.72);backdrop-filter:blur(6px);"></div>

  <div style="position:relative;width:100%;max-width:600px;max-height:90vh;background:#1a0b2e;color:#fff;border-radius:20px;box-shadow:0 24px 64px rgba(0,0,0,0.6);display:flex;flex-direction:column;">

    <!-- Header fijo -->
    <div style="flex-shrink:0;display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:24px 24px 18px;">
      <div>
        <h2 id="cookie-modal-title" style="margin:0;font-size:1.2rem;font-weight:700;color:#fff;">Preferencias de cookies</h2>
        <p style="margin:8px 0 0;font-size:0.875rem;line-height:1.5;color:rgba(255,255,255,0.65);">
          Elige qué categorías quieres permitir. Puedes cambiar esta configuración en cualquier momento.
        </p>
      </div>
      <button
        type="button"
        id="cookie-modal-close"
        aria-label="Cerrar"
        style="flex-shrink:0;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:0;cursor:pointer;color:rgba(255,255,255,0.7);border-radius:8px;margin-top:-2px;"
        onmouseover="this.style.color='#fff'"
        onmouseout="this.style.color='rgba(255,255,255,0.7)'"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Zona scrollable: categorías + política -->
    <div style="flex:1;overflow-y:auto;padding:0 24px 8px;">

      <!-- Categorías -->
      <div style="display:flex;flex-direction:column;gap:10px;">

        <!-- Necesarias -->
        <label style="display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.06);border-radius:14px;padding:16px 18px;">
          <span>
            <span style="display:block;font-size:0.975rem;font-weight:700;color:#fff;">Necesarias</span>
            <span style="display:block;margin-top:3px;font-size:0.84rem;color:rgba(255,255,255,0.6);">Imprescindibles para el funcionamiento del sitio. No se pueden desactivar.</span>
          </span>
          <input type="checkbox" checked disabled style="width:20px;height:20px;flex-shrink:0;cursor:not-allowed;accent-color:#694BD6;" />
        </label>

        <!-- Analíticas -->
        <label style="display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.06);border-radius:14px;padding:16px 18px;cursor:pointer;">
          <span>
            <span style="display:block;font-size:0.975rem;font-weight:700;color:#fff;">Analíticas</span>
            <span style="display:block;margin-top:3px;font-size:0.84rem;color:rgba(255,255,255,0.6);">Nos ayudan a entender cómo se usa la plataforma para mejorarla.</span>
          </span>
          <input type="checkbox" data-cookie-category="analytics" style="width:20px;height:20px;flex-shrink:0;cursor:pointer;accent-color:#694BD6;" />
        </label>

        <!-- Marketing -->
        <label style="display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.06);border-radius:14px;padding:16px 18px;cursor:pointer;">
          <span>
            <span style="display:block;font-size:0.975rem;font-weight:700;color:#fff;">Marketing</span>
            <span style="display:block;margin-top:3px;font-size:0.84rem;color:rgba(255,255,255,0.6);">Se utilizan para mostrarte contenido y anuncios personalizados.</span>
          </span>
          <input type="checkbox" data-cookie-category="marketing" style="width:20px;height:20px;flex-shrink:0;cursor:pointer;accent-color:#694BD6;" />
        </label>

        <!-- Personalización -->
        <label style="display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid rgba(255,255,255,0.12);background:rgba(255,255,255,0.06);border-radius:14px;padding:16px 18px;cursor:pointer;">
          <span>
            <span style="display:block;font-size:0.975rem;font-weight:700;color:#fff;">Personalización</span>
            <span style="display:block;margin-top:3px;font-size:0.84rem;color:rgba(255,255,255,0.6);">Recuerdan tus preferencias para ofrecerte una experiencia adaptada.</span>
          </span>
          <input type="checkbox" data-cookie-category="personalization" style="width:20px;height:20px;flex-shrink:0;cursor:pointer;accent-color:#694BD6;" />
        </label>
      </div>

      <!-- Política de Cookies integrada -->
      <div style="margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.1);">
        <p style="margin:0 0 14px;font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:rgba(255,255,255,0.4);">Política de Cookies</p>

        <div style="font-size:0.84rem;line-height:1.7;color:rgba(255,255,255,0.7);">

          <p style="margin:0 0 4px;font-weight:700;color:#fff;">1. ¿Qué son las cookies?</p>
          <p style="margin:0 0 4px;">Las cookies son pequeños archivos de texto que se guardan en tu dispositivo cuando visitas un sitio web.</p>
          <p style="margin:0 0 4px;">Sirven para recordar tus preferencias, mejorar el rendimiento del sitio y, en algunos casos, recopilar información estadística o de personalización.</p>
          <p style="margin:0 0 16px;">Las cookies <strong style="color:#fff;">no almacenan información personal sensible</strong> como nombres, contraseñas o datos financieros.</p>

          <p style="margin:0 0 4px;font-weight:700;color:#fff;">2. ¿Qué tipos de cookies usamos?</p>
          <p style="margin:0 0 3px;"><strong style="color:rgba(255,255,255,0.9);">Cookies necesarias:</strong> Imprescindibles para el funcionamiento del sitio. No requieren consentimiento.</p>
          <p style="margin:0 0 3px;"><strong style="color:rgba(255,255,255,0.9);">Cookies analíticas:</strong> Nos permiten entender cómo los usuarios interactúan con la plataforma para mejorarla.</p>
          <p style="margin:0 0 3px;"><strong style="color:rgba(255,255,255,0.9);">Cookies de marketing:</strong> Utilizadas para mostrar contenido y anuncios personalizados según tus intereses.</p>
          <p style="margin:0 0 16px;"><strong style="color:rgba(255,255,255,0.9);">Cookies de personalización:</strong> Recuerdan tus preferencias de idioma, región y configuración.</p>

          <p style="margin:0 0 4px;font-weight:700;color:#fff;">3. ¿Cómo puedes gestionar las cookies?</p>
          <p style="margin:0 0 4px;">Puedes configurar tus preferencias en cualquier momento desde este panel. También puedes gestionarlas desde tu navegador:</p>
          <ul style="margin:4px 0 16px;padding-left:18px;">
            <li>Chrome: Configuración → Privacidad y seguridad → Cookies</li>
            <li>Firefox: Opciones → Privacidad y seguridad</li>
            <li>Safari: Preferencias → Privacidad</li>
            <li>Edge: Configuración → Privacidad, búsqueda y servicios</li>
          </ul>

          <p style="margin:0 0 4px;font-weight:700;color:#fff;">4. Cookies de terceros</p>
          <p style="margin:0 0 16px;">Algunos servicios integrados pueden establecer sus propias cookies. Estos terceros tienen sus propias políticas de privacidad.</p>

          <p style="margin:0 0 4px;font-weight:700;color:#fff;">5. Actualizaciones de esta política</p>
          <p style="margin:0 0 4px;">EcoNutrix puede actualizar esta política en cualquier momento. La versión vigente estará siempre disponible en esta página.</p>
          <p style="margin:0 0 8px;">Consultas: <a href="mailto:privacidad@econutrix.com" style="color:#a78bfa;text-decoration:underline;">privacidad@econutrix.com</a></p>
        </div>
      </div>
    </div>

    <!-- Footer fijo -->
    <div style="flex-shrink:0;display:flex;flex-direction:row;gap:12px;border-top:1px solid rgba(255,255,255,0.1);padding:16px 24px;">
      <button
        type="button"
        id="cookie-reject-all"
        style="flex:1;padding:13px 16px;font-size:0.9rem;font-weight:500;color:#fff;background:transparent;border:1.5px solid rgba(255,255,255,0.25);border-radius:12px;cursor:pointer;"
        onmouseover="this.style.background='rgba(255,255,255,0.08)'"
        onmouseout="this.style.background='transparent'"
      >
        Rechazar opcionales
      </button>
      <button
        type="button"
        id="cookie-save"
        style="flex:1;padding:13px 16px;font-size:0.9rem;font-weight:700;color:#fff;background:#694BD6;border:0;border-radius:12px;cursor:pointer;"
        onmouseover="this.style.background='#7a5ee0'"
        onmouseout="this.style.background='#694BD6'"
      >
        Guardar preferencias
      </button>
    </div>
  </div>
</div>


<script is:inline>
  (function () {
    const STORAGE_KEY = 'econutrix:cookie-consent';
    const banner = document.getElementById('cookie-banner');
    const modal  = document.getElementById('cookie-modal');
    if (!banner || !modal) return;

    const checkboxes = modal.querySelectorAll('input[data-cookie-category]');

    /* ── helpers ── */
    function readStored() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null'); }
      catch (_) { return null; }
    }

    function hideBanner() {
      banner.style.display = 'none';
    }

    function showBanner() {
      banner.style.display = '';
    }

    function save(consent) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ ...consent, ts: Date.now() })); }
      catch (_) {}
      hideBanner();
      closeModal();
    }

    function openModal() {
      const stored = readStored();
      checkboxes.forEach((cb) => {
        const key = cb.getAttribute('data-cookie-category');
        cb.checked = stored && stored.categories ? !!stored.categories[key] : false;
      });
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    function collectCategories() {
      const cats = { necessary: true };
      checkboxes.forEach((cb) => {
        const key = cb.getAttribute('data-cookie-category');
        if (key) cats[key] = cb.checked;
      });
      return cats;
    }

    /* ── mostrar siempre (sin verificar localStorage) ── */
    showBanner();

    /* ── eventos ── */
    document.getElementById('cookie-accept')?.addEventListener('click', () =>
      save({ value:'accepted-all', categories:{ necessary:true, analytics:true, marketing:true, personalization:true } })
    );
    document.getElementById('cookie-close')?.addEventListener('click', () =>
      save({ value:'dismissed', categories:{ necessary:true } })
    );
    document.getElementById('cookie-configure')?.addEventListener('click', openModal);
    document.getElementById('cookie-policy-open')?.addEventListener('click', openModal);
    document.getElementById('cookie-modal-close')?.addEventListener('click', closeModal);
    document.getElementById('cookie-modal-backdrop')?.addEventListener('click', closeModal);
    document.getElementById('cookie-reject-all')?.addEventListener('click', () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      save({ value:'rejected-optional', categories:collectCategories() });
    });
    document.getElementById('cookie-save')?.addEventListener('click', () =>
      save({ value:'custom', categories:collectCategories() })
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.style.display !== 'none') closeModal();
    });
  })();
</script>
