---
// Cookie consent banner + preferences modal
---

<!-- Banner -->
<div
  id=”cookie-banner”
  class=”fixed inset-x-0 bottom-0 z-[9998] px-3 pb-3 pt-0 sm:bottom-6 sm:px-6 sm:pb-0”
  role=”dialog”
  aria-live=”polite”
  aria-label=”Aviso de cookies”
>
  <div class=”relative mx-auto max-w-[1480px] border-t-2 bg-black px-4 py-4 text-white shadow-[0_-4px_40px_rgba(0,0,0,0.6)] ring-1 ring-white/5 sm:px-6 sm:py-5 md:py-6 lg:px-10” style=”border-top-color: #694BD6;”>

    <!-- X siempre en la esquina superior derecha -->
    <button
      type=”button”
      id=”cookie-close”
      aria-label=”Cerrar aviso de cookies”
      class=”absolute right-3 top-3 inline-flex h-8 w-8 items-center justify-center rounded-md text-white/60 transition hover:bg-white/10 hover:text-white focus:outline-none sm:right-4 sm:top-4”
    >
      <svg xmlns=”http://www.w3.org/2000/svg” width=”18” height=”18” viewBox=”0 0 24 24” fill=”none” stroke=”currentColor” stroke-width=”2” stroke-linecap=”round” stroke-linejoin=”round” aria-hidden=”true”>
        <line x1=”18” y1=”6” x2=”6” y2=”18”></line>
        <line x1=”6” y1=”6” x2=”18” y2=”18”></line>
      </svg>
    </button>

    <!-- Texto — deja espacio derecho para la X en mobile -->
    <div class=”pr-8 text-sm leading-relaxed text-white/90 sm:pr-0 md:max-w-3xl”>
      <p>Utilizamos cookies para mejorar tu experiencia, analizar el uso de la plataforma y ofrecer contenido personalizado.</p>
      <a
        href=”/politica-de-cookies”
        class=”mt-1 inline-block underline underline-offset-2 transition-opacity hover:opacity-80”
        style=”color: #694BD6; text-decoration-color: rgba(105, 75, 214, 0.7);”
      >
        “Más información en nuestra Política de Cookies”
      </a>
    </div>

    <!-- Botones: fila en mobile y desktop -->
    <div class=”mt-3 flex flex-wrap items-center gap-2 sm:mt-0 md:absolute md:right-10 md:top-1/2 md:-translate-y-1/2 md:flex-nowrap md:gap-3”>
      <button
        type=”button”
        id=”cookie-configure”
        class=”flex-1 rounded-md border px-4 py-2 text-sm font-medium text-white underline underline-offset-4 transition focus:outline-none sm:flex-none”
        style=”border-color: #694BD6;”
        onmouseover=”this.style.backgroundColor='rgba(105,75,214,0.12)'”
        onmouseout=”this.style.backgroundColor='transparent'”
      >
        Configurar cookies
      </button>
      <button
        type=”button”
        id=”cookie-accept”
        class=”flex-1 rounded-md px-4 py-2 text-sm font-semibold text-white transition focus:outline-none sm:flex-none”
        style=”background-color: #694BD6;”
        onmouseover=”this.style.backgroundColor='#7a5ee0'”
        onmouseout=”this.style.backgroundColor='#694BD6'”
      >
        Aceptar todo
      </button>
    </div>
  </div>
</div>

<!-- Preferences modal -->
<div
  id="cookie-modal"
  class="fixed inset-0 z-[10000] hidden items-end justify-center sm:items-center sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cookie-modal-title"
>
  <div id="cookie-modal-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="relative w-full max-w-lg overflow-hidden rounded-t-3xl bg-[#1a0b2e] text-white shadow-2xl ring-1 ring-white/10 sm:rounded-2xl">

    <!-- Drag handle (mobile) -->
    <div class="flex justify-center pt-3 pb-1 sm:hidden">
      <div class="h-1 w-10 rounded-full bg-white/20"></div>
    </div>

    <div class="flex items-start justify-between gap-4 border-b border-white/10 px-5 py-4 sm:px-6 sm:py-5">
      <div>
        <h2 id="cookie-modal-title" class="text-base font-semibold sm:text-lg">Preferencias de cookies</h2>
        <p class="mt-1 text-xs text-white/70 sm:text-sm">
          Elige qué categorías quieres permitir. Puedes cambiar esta configuración en cualquier momento.
        </p>
      </div>
      <button
        type="button"
        id="cookie-modal-close"
        aria-label="Cerrar"
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-white/80 transition hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-300 sm:h-9 sm:w-9"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="max-h-[55vh] space-y-3 overflow-y-auto overscroll-contain px-5 py-4 sm:max-h-[60vh] sm:space-y-4 sm:px-6 sm:py-5">
      <!-- Necessary -->
      <label class="flex items-start justify-between gap-4 rounded-lg border border-white/10 bg-white/5 p-4">
        <span class="flex-1">
          <span class="block text-sm font-semibold text-white">Necesarias</span>
          <span class="mt-1 block text-xs text-white/70">
            Imprescindibles para el funcionamiento del sitio. No se pueden desactivar.
          </span>
        </span>
        <input
          type="checkbox"
          checked
          disabled
          class="mt-1 h-4 w-4 cursor-not-allowed rounded border-white/20 bg-white/10 accent-purple-500"
        />
      </label>

      <!-- Analytics -->
      <label class="flex items-start justify-between gap-4 rounded-lg border border-white/10 bg-white/5 p-4">
        <span class="flex-1">
          <span class="block text-sm font-semibold text-white">Analíticas</span>
          <span class="mt-1 block text-xs text-white/70">
            Nos ayudan a entender cómo se usa la plataforma para mejorarla.
          </span>
        </span>
        <input
          type="checkbox"
          data-cookie-category="analytics"
          class="mt-1 h-4 w-4 cursor-pointer rounded border-white/20 bg-white/10 accent-purple-500"
        />
      </label>

      <!-- Marketing -->
      <label class="flex items-start justify-between gap-4 rounded-lg border border-white/10 bg-white/5 p-4">
        <span class="flex-1">
          <span class="block text-sm font-semibold text-white">Marketing</span>
          <span class="mt-1 block text-xs text-white/70">
            Se utilizan para mostrarte contenido y anuncios personalizados.
          </span>
        </span>
        <input
          type="checkbox"
          data-cookie-category="marketing"
          class="mt-1 h-4 w-4 cursor-pointer rounded border-white/20 bg-white/10 accent-purple-500"
        />
      </label>

      <!-- Personalization -->
      <label class="flex items-start justify-between gap-4 rounded-lg border border-white/10 bg-white/5 p-4">
        <span class="flex-1">
          <span class="block text-sm font-semibold text-white">Personalización</span>
          <span class="mt-1 block text-xs text-white/70">
            Recuerdan tus preferencias para ofrecerte una experiencia adaptada.
          </span>
        </span>
        <input
          type="checkbox"
          data-cookie-category="personalization"
          class="mt-1 h-4 w-4 cursor-pointer rounded border-white/20 bg-white/10 accent-purple-500"
        />
      </label>
    </div>

    <div class="flex flex-col gap-2 border-t border-white/10 bg-black/20 px-5 py-4 sm:flex-row sm:justify-end sm:gap-3 sm:px-6">
      <button
        type="button"
        id="cookie-reject-all"
        class="rounded-md border border-white/20 px-4 py-2 text-sm font-medium text-white transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-300"
      >
        Rechazar opcionales
      </button>
      <button
        type="button"
        id="cookie-save"
        class="rounded-md px-4 py-2 text-sm font-semibold text-white transition focus:outline-none focus-visible:ring-2"
        style="background-color: #694BD6; --tw-ring-color: rgba(105,75,214,0.6);"
        onmouseover="this.style.backgroundColor='#7a5ee0'"
        onmouseout="this.style.backgroundColor='#694BD6'"
      >
        Guardar preferencias
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'econutrix:cookie-consent';
    const banner = document.getElementById('cookie-banner');
    const modal = document.getElementById('cookie-modal');
    if (!banner || !modal) return;

    const checkboxes = modal.querySelectorAll('input[data-cookie-category]');

    function readStored() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (_) {
        return null;
      }
    }

    function save(consent) {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ ...consent, ts: Date.now() })
        );
      } catch (_) {}
      banner.style.display = 'none';
      closeModal();
    }

    function openModal() {
      const stored = readStored();
      checkboxes.forEach((cb) => {
        const key = cb.getAttribute('data-cookie-category');
        cb.checked = stored && stored.categories ? !!stored.categories[key] : false;
      });
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }

    function collectCategories() {
      const categories = { necessary: true };
      checkboxes.forEach((cb) => {
        const key = cb.getAttribute('data-cookie-category');
        if (key) categories[key] = cb.checked;
      });
      return categories;
    }

    function showBanner() {
      banner.style.display = '';
    }

    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      save({
        value: 'accepted-all',
        categories: { necessary: true, analytics: true, marketing: true, personalization: true },
      });
    });

    document.getElementById('cookie-close')?.addEventListener('click', () => {
      save({ value: 'dismissed', categories: { necessary: true } });
    });

    document.getElementById('cookie-configure')?.addEventListener('click', openModal);
    document.getElementById('cookie-modal-close')?.addEventListener('click', closeModal);
    document.getElementById('cookie-modal-backdrop')?.addEventListener('click', closeModal);

    document.getElementById('cookie-reject-all')?.addEventListener('click', () => {
      checkboxes.forEach((cb) => (cb.checked = false));
      save({ value: 'rejected-optional', categories: collectCategories() });
    });

    document.getElementById('cookie-save')?.addEventListener('click', () => {
      save({ value: 'custom', categories: collectCategories() });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  })();
</script>
