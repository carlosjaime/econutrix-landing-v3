---
// ScrollMotion — IntersectionObserver + CSS transitions
// Compatible con todos los browsers modernos
---

<style is:global>
/* ═══════════════════════════════════════════════════════════════
   ESTADOS INICIALES — ocultos antes de entrar al viewport
═══════════════════════════════════════════════════════════════ */

[data-motion="heading"],
[data-motion="text"],
[data-motion="button"],
[data-motion="card"],
[data-motion="media"] {
  opacity: 0;
  will-change: opacity, transform, filter;
}

[data-motion="heading"] {
  transform: translateX(-36px) scale(0.97);
  filter: blur(6px);
  transition:
    opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
    filter 0.6s ease;
}

[data-motion="text"] {
  transform: translateY(28px);
  filter: blur(4px);
  transition:
    opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
    filter 0.5s ease;
}

[data-motion="button"] {
  transform: translateY(20px) scale(0.88);
  transition:
    opacity 0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
    transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
}

[data-motion="card"] {
  transform: translateY(44px) scale(0.94);
  filter: blur(3px);
  transition:
    opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
    filter 0.5s ease;
}

[data-motion="media"] {
  transform: scale(0.93);
  filter: blur(8px);
  transition:
    opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
    filter 0.65s ease;
}


/* ═══════════════════════════════════════════════════════════════
   ESTADO VISIBLE — clase añadida por JS al entrar al viewport
═══════════════════════════════════════════════════════════════ */

[data-motion].is-visible {
  opacity: 1;
  transform: none;
  filter: none;
}


/* ═══════════════════════════════════════════════════════════════
   STAGGER — delay por posición dentro del contenedor
═══════════════════════════════════════════════════════════════ */

[data-motion-stagger] > [data-motion]:nth-child(1) { transition-delay: 0ms; }
[data-motion-stagger] > [data-motion]:nth-child(2) { transition-delay: 80ms; }
[data-motion-stagger] > [data-motion]:nth-child(3) { transition-delay: 160ms; }
[data-motion-stagger] > [data-motion]:nth-child(4) { transition-delay: 240ms; }
[data-motion-stagger] > [data-motion]:nth-child(5) { transition-delay: 320ms; }
[data-motion-stagger] > [data-motion]:nth-child(6) { transition-delay: 400ms; }


/* ═══════════════════════════════════════════════════════════════
   NAVBAR — background cambia con scroll
═══════════════════════════════════════════════════════════════ */

.hero__header-inner {
  transition:
    background 0.3s ease,
    box-shadow 0.3s ease,
    backdrop-filter 0.3s ease;
}

.hero__header-inner.is-scrolled {
  background: rgba(6, 7, 28, 0.93) !important;
  backdrop-filter: blur(18px) saturate(165%);
  -webkit-backdrop-filter: blur(18px) saturate(165%);
  box-shadow: 0 4px 36px rgba(0, 0, 0, 0.44);
}


/* ═══════════════════════════════════════════════════════════════
   NAV LINKS — subrayado animado
═══════════════════════════════════════════════════════════════ */

.hero__nav a {
  position: relative;
  padding-bottom: 3px;
  transition: color 0.22s ease;
}

.hero__nav a::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 50%;
  width: 0;
  height: 2px;
  background: linear-gradient(90deg, #b454b5, #9b4de0);
  border-radius: 2px;
  transition:
    width 0.28s cubic-bezier(0.4, 0, 0.2, 1),
    left  0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.hero__nav a:hover::after { width: 100%; left: 0; }

.hero__nav a:hover {
  color: #f0d8f0 !important;
  text-shadow: 0 0 10px rgba(180, 84, 181, 0.45) !important;
}


/* ═══════════════════════════════════════════════════════════════
   FLOATING — planeta decorativo
═══════════════════════════════════════════════════════════════ */

@keyframes sm-float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  33%       { transform: translateY(-14px) rotate(1.5deg); }
  66%       { transform: translateY(-6px) rotate(-1deg); }
}

[data-float] {
  animation: sm-float 7s ease-in-out infinite;
  will-change: transform;
}
[data-float="slow"] { animation-duration: 10s; }
[data-float="fast"]  { animation-duration: 5s; }


/* ═══════════════════════════════════════════════════════════════
   CARD HOVER — lift suave
═══════════════════════════════════════════════════════════════ */

[data-motion="card"].is-visible {
  transition:
    opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
    filter 0.5s ease;
}


/* ═══════════════════════════════════════════════════════════════
   SHIMMER en cards de pricing
═══════════════════════════════════════════════════════════════ */

@keyframes sm-shimmer {
  0%   { background-position: -200% center; }
  100% { background-position: 200% center; }
}

article[data-motion="card"] { position: relative; overflow: hidden; }

article[data-motion="card"]::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.06) 50%, transparent 60%);
  background-size: 200% 100%;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
  z-index: 1;
}

article[data-motion="card"]:hover::before {
  opacity: 1;
  animation: sm-shimmer 0.7s ease forwards;
}


/* ═══════════════════════════════════════════════════════════════
   ACCESIBILIDAD — prefers-reduced-motion
═══════════════════════════════════════════════════════════════ */

@media (prefers-reduced-motion: reduce) {
  [data-motion] {
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
    transition: none !important;
  }
  [data-float] {
    animation: none !important;
  }
}
</style>

<script>
  // ── IntersectionObserver — revela elementos al entrar al viewport ──
  function initScrollReveal() {
    const els = document.querySelectorAll<HTMLElement>('[data-motion]');

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );

    els.forEach((el) => io.observe(el));
  }

  // ── Navbar scroll ──────────────────────────────────────────────
  function initNavbar() {
    const header = document.querySelector<HTMLElement>('.hero__header-inner');
    if (!header) return;

    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 40);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // ── Contador animado ──────────────────────────────────────────
  function initCounters() {
    const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
    if (!counters.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.counter ?? '0', 10);
          const start = performance.now();
          const duration = 1400;

          const tick = (now: number) => {
            const p = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(eased * target).toLocaleString('es-CL');
            if (p < 1) requestAnimationFrame(tick);
          };

          requestAnimationFrame(tick);
          io.unobserve(el);
        });
      },
      { threshold: 0.5 }
    );

    counters.forEach((el) => io.observe(el));
  }

  document.addEventListener('DOMContentLoaded', () => {
    initScrollReveal();
    initNavbar();
    initCounters();
  });
</script>
