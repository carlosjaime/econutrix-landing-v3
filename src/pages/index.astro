---
import HeroSection from '../components/HeroSection.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
import PainPointsSection from '../components/sections/PainPointsSection.astro';
import StepsSection from '../components/sections/StepsSection.astro';
import FeaturesSection from '../components/sections/FeaturesSection.astro';
import ContextTagsSection from '../components/sections/ContextTagsSection.astro';
import EarlyAccessSection from '../components/sections/EarlyAccessSection.astro';
import EmailCaptureSection from '../components/sections/EmailCaptureSection.astro';
import PreFooterCtaSection from '../components/sections/PreFooterCtaSection.astro';
import SiteFooterSection from '../components/sections/SiteFooterSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageDescription, pageTitle } from '../data/landing';

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;
const ogImageURL = new URL('/favicon.svg', Astro.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'EcoNutrix',
  url: canonicalURL,
  inLanguage: 'es',
  description: pageDescription,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${canonicalURL}#acceso`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={canonicalURL}
  ogImageURL={ogImageURL}
  structuredData={structuredData}
>
  <!--
    LandingPage EcoNutrix
    Author: Carlos Jaime Lopez Martinez
    Fecha: 20-Abril-2026
  -->
  <HeroSection />
  <PainPointsSection />
  <StepsSection />
  <FeaturesSection />
  <ContextTagsSection />
  <EarlyAccessSection />
  <EmailCaptureSection />
  <PreFooterCtaSection />
  <SiteFooterSection />
  <ScrollMotion />
</BaseLayout>
