    <meta property="og:description" content="Términos y Condiciones de uso de la plataforma EcoNutrix." />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="EcoNutrix" />

    <!-- Favicon para navegadores modernos -->
    <link rel="icon" type="image/x-icon" href="/favicon_io/favicon.ico" />
