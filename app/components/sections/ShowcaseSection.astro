---
import {Image} from "astro:assets";
import GridImage from "../../assets/grid.webp"
import featureImage from "../../assets/card-float-econutrix.webp";
---

<section class="relative bg-linear-to-b from-[#332890] to-[#A34DA3] text-white overflow-hidden">
    <div class="absolute bottom-0 w-2/3">
        <Image src={GridImage} alt="" aria-hidden="true" class="w-full h-full object-cover"/>
    </div>

    <div class="mt-12 md:mt-24">
        <div class="w-full flex flex-col md:flex-row justify-between items-center gap-12">
            <div class="flex flex-col gap-6 px-6 md:px-24 text-center md:text-left">
                <h2 class="text-4xl md:text-6xl font-bold">Con escaner inteligente,</h2>
                <p class="text-xl md:text-3xl">y una foto de la boleta, la app digitaliza ingredientes y calorías.</p>
                <p class="text-lg md:text-xl">Evita el desperdicio de alimentos y comienza a <strong>cuidar tu nutrición y
                    salud.</strong></p>
            </div>
            <div class="w-full md:w-auto flex justify-end">
                <Image
                        src={featureImage}
                        alt="Vista previa de la app EcoNutrix"
                        aria-hidden="true"
                        class="rounded-l-2xl md:rounded-l-none md:rounded-tl-2xl shadow-2xl transform transition-transform duration-300 w-4/5 md:w-auto"
                        loading="lazy"
                        format="webp"
                />
            </div>
        </div>
    </div>
</section>