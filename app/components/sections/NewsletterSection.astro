            </svg>

        </div>

        <div class="max-w-3xl mx-auto">
            <h2 class="font-display text-3xl md:text-4xl font-semibold text-gray-800">¿Listo para ser el primero en
                descubrirlo?</h2>
            <p class="mt-4 text-xl text-gray-600">Suscríbete y entérate antes que nadie.</p>

            <form class="mt-8 max-w-lg mx-auto" data-newsletter-form>
                <div class="flex items-end">
                    <div class="grow text-left">
                        <label for="email" class="text-sm font-medium text-gray-700">Email</label>
                        <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                class="mt-1 w-full h-12 px-4 outline-none bg-white border-2 border-gray-300 border-r-0 rounded-l-lg transition focus:border-primary"
                                aria-describedby="email-error"
                        />
                    </div>
                    <button type="submit"
                            class="h-12 px-6 bg-linear-to-b from-[#332890] to-[#A34DA3] text-white font-semibold rounded-r-lg shadow-md transition transform disabled:opacity-50 disabled:cursor-not-allowed flex items-center cursor-pointer">
                        <span data-button-text>Suscribirme</span>
                        <span data-loader class="ml-2 size-4 border-2 rounded-full border-t-transparent animate-spin hidden" />
                    </button>
                </div>
                <p id="email-error" class="hidden mt-2 text-sm text-red-600 text-left" aria-live="assertive"></p>
            </form>

        </div>
    </div>

    <div id="success-modal"
         class="fixed inset-0 bg-black/50 z-50 p-4 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
         data-success-modal>
        <div
                class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8 text-center transform scale-95 transition-transform duration-300">
            <div class="mx-auto h-16 w-16 rounded-full bg-green-100 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-check"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>
            </div>
            <h3 class="mt-4 text-2xl font-bold text-gray-800">¡Suscripción Exitosa!</h3>
            <p class="mt-2 text-gray-600">
                Revisa tu bandeja de entrada para ser de los primeros en probar <span class="font-semibold text-primary">EcoNutrix</span>.
            </p>
            <button data-close-modal
                    class="mt-6 w-full py-3 bg-linear-to-br from-primary to-purple-600 text-white font-semibold rounded-lg">
                Entendido
            </button>
        </div>
    </div>
</section>

<script>
    const STATES = {
        IDLE: 'idle',
        LOADING: 'loading',
        SUCCESS: 'success',
        ERROR: 'error',
    };

    function newsletterFormController() {
        const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
        if (!form) return;

        const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
        const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const buttonText = form.querySelector<HTMLElement>('[data-button-text]');
        const loader = form.querySelector<HTMLElement>('[data-loader]');
        const errorDisplay = form.querySelector<HTMLElement>('#email-error');

        const successModal = document.querySelector<HTMLElement>('[data-success-modal]');
        const closeModalButton = successModal?.querySelector('[data-close-modal]');

        let state = STATES.IDLE;

        function setState(newState: string, errorMessage?: string) {
            state = newState;
            render();
            if (errorMessage && errorDisplay) {
                errorDisplay.textContent = errorMessage;
            }
        }

        function render() {
            const isLoading = state === STATES.LOADING;

            submitButton!.disabled = isLoading;
            buttonText!.textContent = isLoading ? 'Enviando...' : 'Suscribirme';
            loader?.classList.toggle('hidden', !isLoading);

            errorDisplay?.classList.toggle('hidden', state !== STATES.ERROR);

            if (state === STATES.SUCCESS) {
                successModal?.classList.remove('opacity-0', 'pointer-events-none');
                successModal?.querySelector('div')?.classList.remove('scale-95');
            } else {
                successModal?.classList.add('opacity-0', 'pointer-events-none');
                successModal?.querySelector('div')?.classList.add('scale-95');
            }
        }

        async function handleSubmit(e: SubmitEvent) {
            e.preventDefault();
            if (state === STATES.LOADING) return;

            const email = emailInput?.value.trim();

            if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                setState(STATES.ERROR, 'Por favor, ingrese un email válido.');
                return;
            }

            setState(STATES.LOADING);

            try {
                const response = await fetch("https://api.econutrix.com/api/v1/beta-tester/", {
                    method: "POST",
                    headers: {"Content-Type": "application/json"},
                    body: JSON.stringify({email}),
                });

                if (!response.ok) throw new Error('Error en la respuesta del servidor.');

                setState(STATES.SUCCESS);
                form.reset();
            } catch (error) {
                setState(STATES.ERROR, 'No pudimos registrar tu email. Intenta nuevamente.');
            }
        }

        form.addEventListener('submit', handleSubmit);
        emailInput?.addEventListener('input', () => {
            if (state === STATES.ERROR) setState(STATES.IDLE);
        });
        closeModalButton?.addEventListener('click', () => setState(STATES.IDLE));
    }

    document.addEventListener('astro:page-load', newsletterFormController);
</script>