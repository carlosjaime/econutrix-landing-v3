---
import {Image} from "astro:assets";
import mockupImage from "../../assets/mockup.webp";
---
<section class="grid grid-cols-1 lg:grid-cols-2 min-h-screen">

    <div class="relative bg-gray-200 order-last lg:order-first">
        <Image
                src={mockupImage}
                alt="Mockup de la aplicación EcoNutrix en un teléfono"
                class="w-full h-full object-cover"
                loading="lazy"
                format="webp"
        />
    </div>

    <div class="bg-white flex flex-col justify-center py-20 px-6 sm:px-12 lg:px-16">
        <div class="">
            <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-light text-gray-900 leading-none">
                <span class="block">Sé parte del</span>
                <span class="block">1º Lanzamiento de</span>
                <span class="block font-bold text-transparent bg-clip-text bg-linear-to-b from-[#332890] to-[#A34DA3]">
          EcoNutrix
        </span>
            </h2>
            <p>Queda atento a la fecha de lanzamiento,</p>

            <p class="mt-8 text-lg text-gray-600">
