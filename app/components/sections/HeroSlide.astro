---
import type {ImageMetadata} from "astro";
import {cn} from "../../lib/utils.ts";
import Image from "astro/components/Image.astro";
interface Props {
    image: ImageMetadata,
    alt: string,
    class?: string
}

const props = Astro.props
---

<div class={cn("absolute inset-0", props.class)}>
    <Image src={props.image} alt={props.alt} class="w-full h-full object-cover inset-0"/>
    <div class="absolute left-0 top-1/2 -translate-y-1/2 z-10 px-4 py-12 md:p-12 max-w-9/10 md:max-w-212.5 rounded-r-3xl backdrop-blur-sm bg-linear-to-br from-black/80 to-black/30">
        <slot name="message"/>
    </div>
</div>