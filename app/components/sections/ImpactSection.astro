---
import { Image } from "astro:assets";
import GridCascade from "../../assets/grid-cascade.webp"
---

<section
        class="relative bg-linear-to-b from-0% from-[#474444] via-60% via-[#1A1919] to-100% to-[#332890] min-h-[70vh] flex items-center text-white overflow-hidden py-24 px-4"
>
    <div
            class="absolute opacity-20 inset-0"
    >
        <Image src={GridCascade} alt="" aria-hidden="true"
             class="w-full h-full object-cover"/>
    </div>

    <div class="relative z-10 container mx-auto text-left">
        <h4 class="max-w-5xl font-bold text-xl md:text-5xl leading-tight">
            <span class="block">Reduce tu Gasto Mensual y evita</span>
            <span class="block">el desperdicio de alimentos con la</span>
            <span class="block">Gestión de EcoNutrix.</span>
        </h4>
        <p class="max-w-xl mt-6 font-quicksand text-lg md:text-3xl leading-relaxed opacity-90">
            Lleva el control de calorías con los
            <strong class="font-semibold text-white">alimentos que tienes en tu despensa.</strong>
        </p>
    </div>
</section>
