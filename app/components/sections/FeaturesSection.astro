                        <path d="M41.3334 24V40" stroke="#6B6A74" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M21.3334 5.33331V10.6666M42.6667 5.33331V10.6666M32 5.33331V10.6666M21.3334 53.3333V58.6666M32 53.3333V58.6666M42.6667 53.3333V58.6666M58.6667 42.6666H53.3334M10.6667 21.3333H5.33337M10.6667 42.6666H5.33337M10.6667 32H5.33337M58.6667 21.3333H53.3334M58.6667 32H53.3334" stroke="#6B6A74" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <p slot="description" class="text-base leading-relaxed">
                    <strong>Recibe recomendaciones</strong> de menús hiperpersonalizados basados en tus ingredientes de despensa física, tu localidad, clima y estado anímico.
                </p>
            </FeatureCard>
        </div>
        <h2 class="mx-auto max-w-350 mt-12 text-2xl md:text-3xl lg:text-4xl font-bold text-center leading-snug px-4 text-[#332890] whitespace-normal md:whitespace-nowrap" style="font-family: Manrope, sans-serif;">
            <span class="font-bold">Transforma tus buenos hábitos</span> <span class="font-normal">en logros y beneficios reales.</span>
        </h2>
    </div>
</section>