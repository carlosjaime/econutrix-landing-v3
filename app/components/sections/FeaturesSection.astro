---
import FeatureCard from "../ui/FeatureCard.astro";
---

<section id="como-funciona" class="py-20 ">
    <div class="container mx-auto px-4">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-center mb-12 text-gray-800">
            ¿Cómo funciona EcoNutrix?
        </h2>

        <div
                class="flex overflow-x-auto snap-x snap-mandatory md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-8 -mx-4 px-4 md:mx-0 md:px-0 pb-8 md:pb-0">
            <FeatureCard title="Mejora tu Nutrición">
                <div slot="icon">
                    <svg width="57" height="49" viewBox="0 0 57 49" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                                d="M24.2571 45.7424C16.7337 40.1166 1.82855 27.2547 1.82855 15.6804C1.82855 8.03025 7.44258 1.82857 15.1619 1.82857C19.1619 1.82857 23.1619 3.1619 28.4952 8.49523C33.8286 3.1619 37.8286 1.82857 41.8285 1.82857C49.5477 1.82857 55.1619 8.03025 55.1619 15.6804C55.1619 27.2547 40.2568 40.1166 32.7334 45.7424C30.2016 47.6355 26.7888 47.6355 24.2571 45.7424Z"
                                stroke="#6B6A74" stroke-width="3.65714" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>

                <p slot="description" class="text-base leading-relaxed">
                    Come de forma <strong>saludable</strong> y equilibrada. Aprende y recibe recomendaciones basadas en fuentes
                    verificadas <strong>para
                    mejorar tu nutrición.</strong>
                </p>
            </FeatureCard>
            <FeatureCard title="Indicador de Impacto ambiental">
