                                fill="#6C6B75"/>
                    </svg>
                </div>
                <p slot="description" class="text-base leading-relaxed">
                    Haz visible el impacto de tus decisiones. <strong>Mide tu Huella de Carbono y Agua</strong>. Celebra cada
                    alimento que <strong>evitas desperdiciar.</strong>
                </p>
            </FeatureCard>
            <FeatureCard title="Alimentación Sostenible">
                <div slot="icon">
                    <svg width="51" height="57" viewBox="0 0 51 57" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                                d="M9.375 28.0417C9.375 23.6857 11.5689 19.3296 14.7083 17.375M25.375 12.0417C25.375 8.48612 26.975 1.375 33.375 1.375M14.7083 9.375C7.34455 9.375 1.375 17.4121 1.375 25.4491C1.375 34.8257 2.70833 41.5233 8.04167 49.5603C12.0962 54.9915 17.509 56.3531 23.2787 52.5491C24.5102 51.7374 26.2398 51.7374 27.4713 52.5491C33.2409 56.3531 38.6539 54.9915 42.7083 49.5603C48.0417 41.5233 49.375 34.8257 49.375 25.4491C49.375 17.4121 43.4054 9.375 36.0417 9.375C32.2406 9.375 28.811 11.4681 26.3822 13.7284C25.8177 14.2536 24.9323 14.2536 24.3678 13.7284C21.939 11.4681 18.5095 9.375 14.7083 9.375Z"
                                stroke="#6B6A74" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <p slot="description" class="text-base leading-relaxed">
                    <strong>Lleva un registro</strong> actualizado de tus ingredientes. Aprovechar lo que tienes para alimentarte bien es ser
                    sostenible y <strong>cuida el Planeta.</strong>
                </p>
            </FeatureCard>
            <FeatureCard title="Inventario Inteligente">
                <div slot="icon">
                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
